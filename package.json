{
  "name": "chongzhen-game",
  "private": true,
  "version": "0.4.0",
  "description": "崇祯·宦海浮沉模拟器 —— 明末宦海人生模拟器（Web / 桌面双端）",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:steam": "tsc --noEmit && vite build --mode steam",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm --prefix tests run test",
    "test:layout": "npm --prefix tests run test:layout",
    "test:choices": "npm --prefix tests run test:choices",
    "test:modals": "npm --prefix tests run test:modals",
    "test:crash": "npm --prefix tests run test:crash",
    "test:fuzz": "npm --prefix tests run test:fuzz",
    "test:mem": "npm --prefix tests run test:mem",
    "test:deadend": "npm --prefix tests run test:deadend",
    "test:ux": "npm --prefix tests run test:ux",
    "check:node": "node scripts/check-node-engine.cjs",
    "check:steam": "node desktop/smoke-test.cjs",
    "audit:shape": "vite-node scripts/audit-event-shape.ts",
    "audit:values": "vite-node scripts/audit-value-domains.ts",
    "audit:dupkeys": "vite-node scripts/audit-dup-keys.ts",
    "audit:flags": "vite-node scripts/audit-flag-reachability.ts",
    "audit:route-gates": "vite-node scripts/audit-route-gates.ts",
    "audit:choice-count": "vite-node scripts/audit-choice-count.ts",
    "audit:economy": "vite-node scripts/audit-state-economy.ts",
    "audit:codex": "vite-node scripts/audit-ending-codex.ts",
    "audit:tags": "vite-node scripts/audit-tag-effects.ts",
    "audit:chrono": "vite-node scripts/audit-anachronism.ts",
    "audit:gating": "vite-node scripts/audit-repeatable-gating.ts",
    "audit:branch": "vite-node scripts/audit-branch.ts",
    "audit:lockout": "vite-node scripts/audit-choice-lockout.ts",
    "audit:afford": "vite-node scripts/audit-affordability.ts",
    "audit:events": "vite-node scripts/audit-events.ts",
    "audit:narrative": "vite-node scripts/audit-narrative-quality.ts",
    "audit:validate": "vite-node scripts/validate-events.ts",
    "assets:icons": "python scripts/generate-icons.py",
    "assets:desktop-icons": "python scripts/generate-desktop-icons.py",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:pack": "npm --prefix desktop run pack",
    "desktop:dist": "npm --prefix desktop run dist",
    "steam:upload": "node desktop/steam/upload.mjs"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.32.0",
    "terser": "^5.49.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
