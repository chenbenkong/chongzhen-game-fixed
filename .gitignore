# =============================================================================
# .gitignore — 崇祯直聘 (React + TS + Vite)
#
# Sections:
#   Dependencies | Build outputs | Build & typecheck logs | Screenshots
#   Dev scratch/temp | Public dev-only pages | Environment | Editor | OS
#   Caches | Logs | Desktop (Electron) | Tests
#
# NOTE: root-anchored patterns use a leading "/" so they can never leak into
# subdirectories. This matters for "/*.png": it ignores dev screenshots dumped
# at the repo root while keeping tracked game art such as src/assets/*.png.
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build outputs ---
dist/
dist-ssr/
*.local
.vite/

# --- Vercel ---
.vercel/

# --- Build & typecheck logs (repo root) ---
# Captures build_out.txt, tsc_out.txt, tsc_out2.txt, tsc-out.txt,
# vite-final.txt, vite-now.txt, vite-startup*.txt and TS incremental build info.
build_out.txt
tsc_out*.txt
tsc-out.txt
vite-*.txt
*.tsbuildinfo

# --- Root-level screenshots (dev by-products) ---
# Only the repo root; committed assets live under src/assets/ and stay tracked.
/*.png
# tests/verify-ux.mjs writes its final shot here.
screenshots/

# --- Dev scratch / temp directories ---
/tmp/

# --- Public dev-only pages (the Vite plugin serving these was removed) ---
public/token-*.json
public/token-*.html
public/file-tree.html

# --- Environment ---
.env
.env.local
.env.*.local
!.env.example

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db

# --- Caches ---
.cache/
.eslintcache
# 覆盖 .npm-cache/ 以及各子工程自建的缓存目录（如 .npm-cache-desktop/）
.npm-cache*/
# python 工具脚本（assets:icons / verify_bgm）跑出来的字节码，曾经被误提交过
__pycache__/

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Desktop (Electron) build artifacts ---
desktop/dist/
desktop/release/
desktop/node_modules/
# steamcmd 上传凭据（含账号信息），绝不入库
desktop/steam/steamconfig.json
desktop/steam/*.vdf
desktop/steam/output/

# --- Tests ---
tests/node_modules/
tests/.cache/
# 端到端 / 布局测试的截图输出：是测试产物而非交付物，且体积达十几 MB
tests/screenshots/

# --- GitHub CLI local config ---
.gh-config/
commit_msg.txt

# --- Steam store assets (regenerate: cd tests && node store-assets.mjs) ---
# 8.8 MB of PNGs. They're build artifacts, not source: the generator is
# tests/store-assets.mjs and the manifest explains which Steamworks slot each
# file goes into, so there's no reason to version 15MB of binaries.
store-assets/